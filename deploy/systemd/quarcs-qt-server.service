[Unit]
Description=QUARCS Qt backend (source 798d1e5) on RDK X5
Wants=indi.service
Requires=quarcs-hub.service
After=indi.service quarcs-hub.service

[Service]
Type=exec
User=quarcs-rdk
Group=quarcs-rdk
StateDirectory=quarcs-rdk
Environment=HOME=/var/lib/quarcs-rdk
Environment=QUARCS_WS_HOST=127.0.0.1
Environment=QUARCS_EXTERNAL_INDI_SERVER=1
Environment=QUARCS_DISABLE_GPIO=1
Environment=QUARCS_DISABLE_PHD2=1
Environment=QUARCS_TOTAL_VERSION=20260909
WorkingDirectory=/opt/quarcs/runtime
ExecStart=/opt/quarcs/bin/client
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ReadWritePaths=/opt/quarcs/runtime /var/www/html/img

[Install]
WantedBy=multi-user.target
